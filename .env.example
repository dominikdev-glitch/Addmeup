# ==============================================================================
# AddMeUp Production Environment Variables (for Render / Hosting)
# ==============================================================================

# Node / Express Server Port (Render sets this automatically to 10000 or custom)
PORT=3000

# ------------------------------------------------------------------------------
# 1. PAYSTACK PAYMENT GATEWAY KEYS
# ------------------------------------------------------------------------------
# Paystack Secret Key (USED ON SERVER for transaction verification & webhooks)
# Get from: Paystack Dashboard -> Settings -> API Keys & Webhooks -> Secret Key (Live)
PAYSTACK_SECRET_KEY="sk_live_your_actual_live_secret_key_here"

# Paystack Public Key (USED ON FRONTEND for popup checkout)
# Get from: Paystack Dashboard -> Settings -> API Keys & Webhooks -> Public Key (Live)
PAYSTACK_PUBLIC_KEY="pk_live_your_actual_live_public_key_here"
VITE_PAYSTACK_PUBLIC_KEY="pk_live_your_actual_live_public_key_here"

# ------------------------------------------------------------------------------
# 2. FIREBASE ADMIN SDK SERVICE ACCOUNT (for Render server-side crediting)
# ------------------------------------------------------------------------------
# Paste the entire JSON file content downloaded from:
# Firebase Console -> Project Settings -> Service Accounts -> "Generate new private key"
# Tip: On Render, you can paste the raw single/multi-line JSON directly, or base64 encode it.
FIREBASE_ADMIN_JSON='{"type":"service_account","project_id":"addmeup-95897","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-...@addmeup-95897.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}'

# Alternative: If you prefer individual variables instead of full JSON:
# FIREBASE_PROJECT_ID="addmeup-95897"
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk-...@addmeup-95897.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 3. AI STUDIO / CLOUD RUN (Injected automatically in AI Studio)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
